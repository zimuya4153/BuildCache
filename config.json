{
  "revision": 5,
  "platform": {
    "plat": "windows",
    "arch": "x64",
    "mode": "release",
    "vsToolset": null
  },
  "repos": {
    "package": {
      "owner": "zimuya4153",
      "repo": "xmake-repo",
      "branch": "main"
    },
    "packageMirrors": [
      "MiracleForest/xmake-repo"
    ],
    "cache": {
      "owner": "zimuya4153",
      "repo": "BuildCache"
    },
    "index": {
      "branch": "index"
    }
  },
  "release": {
    "maxAssetsPerRelease": 800,
    "targetBranch": "assets"
  },
  "artifacts": {
    "container": "7z",
    "containers": {
      "levilamina": "7z"
    }
  },
  "bot": {
    "name": "github-actions[bot]",
    "email": "41898282+github-actions[bot]@users.noreply.github.com",
    "tokenEnv": "BUILDCACHE_BOT_TOKEN"
  },
  "paths": {
    "sandboxRoot": null
  },
  "recipes": {
    "sources": [
      {
        "name": "levimc-repo",
        "url": "https://github.com/LiteLDev/xmake-repo.git"
      },
      {
        "name": "oeotyan-repo",
        "url": "https://github.com/OEOTYAN/xmake-repo.git"
      },
      {
        "name": "xmake-repo",
        "url": "https://github.com/xmake-io/xmake-repo.git"
      }
    ],
    "snapshotMode": "version",
    "cutoffOffsetDays": 3,
    "skipPackages": [
      "cmake",
      "ninja",
      "pkg-config",
      "pkgconf",
      "meson",
      "autoconf",
      "automake",
      "libtool",
      "7z",
      "doxygen",
      "gtkdoc",
      "node",
      "python",
      "perl",
      "nasm",
      "yasm",
      "llvm",
      "llvm-prebuilt",
      "mingw-w64",
      "mingw"
    ]
  },
  "xmake": {
    "minArtifactsVersion": "3.0.0",
    "installRetries": 3,
    "heartbeatSeconds": 30,
    "silentTimeoutSeconds": 1800,
    "verbose": true
  },
  "batch": {
    "defaultSize": 20,
    "maxMatrix": 200
  },
  "plugins": [
    {
      "name": "ll",
      "module": "plugins/ll/plugin.py",
      "enabled": true
    },
    {
      "name": "moredimensions",
      "module": "plugins/upstream.py",
      "enabled": true,
      "settings": {
        "id": "moredimensions",
        "display": "MoreDimensions",
        "upstream": "https://github.com/LiteLDev/MoreDimensions.git",
        "upstream_repo": "LiteLDev/MoreDimensions",
        "recipe_source": "levimc-repo",
        "recipe_package": "more-dimensions",
        "recipeEdits": [
          {
            "find": "import(\"package.tools.*make\")",
            "replace": "import(\"package.tools.xmake\")"
          }
        ],
        "toolchain": "msvc",
        "toolchainAliases": [
          {
            "id": "msvc",
            "toolchain": "msvc"
          },
          {
            "id": "clang-cl",
            "toolchain": "clang-cl"
          }
        ],
        "extra_packages": [
          "levilamina"
        ],
        "entries": [
          {
            "id": "default",
            "configs": {}
          }
        ]
      }
    },
    {
      "name": "bsci",
      "module": "plugins/upstream.py",
      "enabled": true,
      "settings": {
        "id": "bsci",
        "display": "BedrockServerClientInterface",
        "upstream": "https://github.com/OEOTYAN/BedrockServerClientInterface.git",
        "upstream_repo": "OEOTYAN/BedrockServerClientInterface",
        "recipe_source": "oeotyan-repo",
        "recipe_package": "bsci",
        "skipBelow": "0.1.7",
        "toolchain": "msvc",
        "toolchainAliases": [
          {
            "id": "msvc",
            "toolchain": "msvc"
          },
          {
            "id": "clang-cl",
            "toolchain": "clang-cl"
          }
        ],
        "extra_packages": [
          "levilamina"
        ],
        "entries": [
          {
            "id": "server",
            "configs": {
              "target_type": "server"
            }
          },
          {
            "id": "client",
            "from": "0.3.0",
            "configs": {
              "target_type": "client"
            }
          }
        ]
      }
    }
  ]
}
